# 복사해서 쓴다: cp .env.example .env   (.env 는 git 에 올라가지 않는다. 안 만들어도 된다)
# 비밀번호는 여기에 적지 않는다. VPN 별 값(이름·포트·DNS)도 여기가 아니라 등록부(vpns.json)에 있다 —
# 웹 화면이나 python3 gui/vpnctl.py 로 바꾼다.
# 주의: 값 뒤에 주석을 붙이지 않는다(빈 값 뒤의 주석은 값으로 읽힌다).

# 터미널에서 -f 없이 docker compose ps / logs 를 쓰려면 이 줄을 둔다.
# (compose.generated.yml 은 웹 화면이나 vpnctl 을 한 번 실행하면 생긴다)
COMPOSE_FILE=docker-compose.yml:compose.generated.yml

# VPN 연결을 기다리는 시간(초). 넘기면 오류를 내고 다시 시도한다.
VPN_CONNECT_TIMEOUT=60
