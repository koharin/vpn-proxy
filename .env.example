# 복사해서 쓴다: cp .env.example .env   (.env 는 git 에 올라가지 않는다)
# 비밀번호는 여기에 적지 않는다. 필요하면 ovpn/<이름>/auth.txt 에 둔다.
# 주의: 값 뒤에 주석을 붙이지 않는다(빈 값 뒤의 주석은 값으로 읽힌다).
#
# VPN_x_NAME       로그에 찍히는 이름
# VPN_x_DIR        .ovpn 1개(와 인증서, auth.txt)가 든 폴더
# VPN_x_PORT       Mac 의 127.0.0.1 포트
# VPN_x_AUTH_FILE  아이디·비밀번호 파일 이름(폴더 안). 비우면 auth.txt 가 있을 때 그것을 쓴다
# VPN_x_DNS        VPN 이 DNS 를 알려 주지 않을 때만 적는다. 예: 10.0.0.2

VPN_A_NAME=vpn-a
VPN_A_DIR=./ovpn/vpn-a
VPN_A_PORT=1081
VPN_A_AUTH_FILE=
VPN_A_DNS=

VPN_B_NAME=vpn-b
VPN_B_DIR=./ovpn/vpn-b
VPN_B_PORT=1082
VPN_B_AUTH_FILE=
VPN_B_DNS=

VPN_C_NAME=vpn-c
VPN_C_DIR=./ovpn/vpn-c
VPN_C_PORT=1083
VPN_C_AUTH_FILE=
VPN_C_DNS=

# VPN 연결을 기다리는 시간(초). 넘기면 오류를 내고 다시 시도한다.
VPN_CONNECT_TIMEOUT=60
